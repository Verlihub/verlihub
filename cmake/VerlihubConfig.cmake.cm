# Verlihub package configuration, for building plugins outside of Verlihub source:
#
#	find_package(Verlihub 1.7 REQUIRED)
#	target_link_libraries(my_plugin Verlihub::verlihub)
#
# Verlihub::verlihub gives library, headers and defines that Verlihub headers depend on.
# When Verlihub is installed in own prefix, add -DCMAKE_PREFIX_PATH=<prefix> or -DVerlihub_DIR=<prefix>/lib/cmake/Verlihub

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/VerlihubTargets.cmake")

SET(VERLIHUB_VERSION_MAJOR @VERLIHUB_VERSION_MAJOR@)
SET(VERLIHUB_VERSION_MINOR @VERLIHUB_VERSION_MINOR@)
SET(VERLIHUB_VERSION_PATCH @VERLIHUB_VERSION_PATCH@)
SET(VERLIHUB_VERSION_TWEAK @VERLIHUB_VERSION_TWEAK@)
SET(VERLIHUB_VERSION_STRING "@VERLIHUB_VERSION@")

set_and_check(VERLIHUB_INCLUDE_DIR "@PACKAGE_VERLIHUB_HEADER_DIR@")
SET(VERLIHUB_PLUGIN_DIR "@PACKAGE_PLUGINDIR@")

# note: same variables as FindVerlihub.cmake module gives, so older plugin builds keep working
get_target_property(VERLIHUB_INCLUDE_DIRS Verlihub::verlihub INTERFACE_INCLUDE_DIRECTORIES)
SET(VERLIHUB_LIBRARIES Verlihub::verlihub)
SET(VERLIHUB_FOUND TRUE)

check_required_components(Verlihub)
