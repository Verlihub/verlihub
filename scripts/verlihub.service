#
# Verlihub autostart service
#
# Depends on online network and MariaDB/MySQL
# Tested with Ubuntu 24.04
#
# Copy service file into system as super user:
# $ sudo cp ./scripts/verlihub.service /etc/systemd/system/verlihub.service
#
# Enable service as super user:
# $ sudo systemctl enable verlihub.service
#
# Disable service as super user:
# $ sudo systemctl disable verlihub.service
#
# Show service status:
# $ service verlihub status
#
# Manually start hubs:
# $ sudo service verlihub start
#
# Manually stop hubs:
# $ sudo service verlihub stop
#
# Add more ExecStart and ExecStop if you need to start multiple hubs
# Remember that hubs started outside service cannot be stopped with service

[Unit]
# dont touch below
Description=Verlihub
After=network-online.target mysql.service
Wants=network-online.target mysql.service

[Service]
# not needed
#EnvironmentFile=

# start hub 1 from multiple hub list
ExecStart=/usr/local/bin/verlihub --multi --run 1

# start hub 2 from multiple hub list
#ExecStart=/usr/local/bin/verlihub --multi --run 2

# start hub from configuration folder
#ExecStart=/usr/local/bin/verlihub --run /path/to/config

# stop hub 1 from multiple hub list
ExecStop=/usr/local/bin/verlihub --multi --stop 1

# stop hub 2 from multiple hub list
#ExecStop=/usr/local/bin/verlihub --multi --stop 2

# stop hub from configuration folder
#ExecStop=/usr/local/bin/verlihub --stop /path/to/config

# dont touch below
Restart=on-failure
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
